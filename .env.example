# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── LLM provider keys ────────────────────────────────────────────────────────
# Add a key for each provider you want to use. Providers with no key are skipped.
GROQ_API_KEY=<your-groq-api-key>
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# ── Models per provider ───────────────────────────────────────────────────────
# Comma-separated LiteLLM model strings shown in the model picker.
# If left blank, a built-in default list is used for each provider that has a key.
GROQ_MODELS=<groq/model-1,groq/model-2>
OPENAI_MODELS=<openai/model-1,openai/model-2>
ANTHROPIC_MODELS=<anthropic/model-1,anthropic/model-2>

# ── Default agent model ───────────────────────────────────────────────────────
# Must be one of the models listed above.
AGENT_MODEL=<provider/default-model>

# ── Security ─────────────────────────────────────────────────────────────────
# Change to a long random string before deploying (e.g. openssl rand -hex 32).
SCOUT_SECRET_KEY=<long-random-string>

# ── Admin accounts ────────────────────────────────────────────────────────────
# Comma-separated usernames that are always admin, regardless of registration order.
# If unset, the first registered user becomes admin automatically.
SCOUT_ADMIN_USERS=<username1,username2>
