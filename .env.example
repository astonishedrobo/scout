# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── LLM provider keys ────────────────────────────────────────────────────────
# Add a key for each provider you want to use. Providers with no key are skipped.
GROQ_API_KEY=<your-groq-api-key>
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Alternatively set *_FILE to a mounted Docker secret path.

# Model catalogs and the default agent model live in config/scout.yaml.

# ── Security ─────────────────────────────────────────────────────────────────
# Change to a long random string before deploying (e.g. openssl rand -hex 32).
SCOUT_SECRET_KEY=<long-random-string>
SCOUT_SECRET_KEY_FILE=
SCOUT_WORKER_SECRET_FILE=

# ── Admin accounts ────────────────────────────────────────────────────────────
# Comma-separated usernames that are always admin, regardless of registration order.
# If unset, the first registered user becomes admin automatically.
SCOUT_ADMIN_USERS=<username1,username2>
