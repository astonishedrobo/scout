# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── LLM provider keys ────────────────────────────────────────────────────────
# Add a key for each provider you want to use. Providers with no key are skipped.
GROQ_API_KEY=<your-groq-api-key>
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# `scout deploy` adds local-vLLM settings only when selected.

# ── MCP integration keys ────────────────────────────────────────────────────
# Used when Exa Search is enabled in config/mcp.yaml or through `scout deploy`.
EXA_API_KEY=

SCOUT_PORT=4200
# Bind address for the published port; use 127.0.0.1 for local-only access.
SCOUT_BIND_ADDRESS=0.0.0.0
# Alternatively set *_FILE to a mounted Docker secret path.

# Model catalogs and the default agent model live in config/scout.yaml.

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
# Set LANGSMITH_TRACING=true to send LangGraph traces to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scout
# Change the endpoint for EU, APAC, AWS, or self-hosted LangSmith deployments.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only when the API key can access multiple LangSmith workspaces.
LANGSMITH_WORKSPACE_ID=

# ── Security ─────────────────────────────────────────────────────────────────
# Change to a long random string before deploying (e.g. openssl rand -hex 32).
SCOUT_SECRET_KEY=<long-random-string>
SCOUT_WORKER_SECRET=<different-long-random-string>
SCOUT_SECRET_KEY_FILE=
SCOUT_WORKER_SECRET_FILE=

# ── Admin accounts ────────────────────────────────────────────────────────────
# Comma-separated usernames that are always admin, regardless of registration order.
# If unset, the first registered user becomes admin automatically.
SCOUT_ADMIN_USERS=<username1,username2>
