{
  "name": "scout-cli",
  "version": "0.1.0",
  "description": "Scout — an AI-powered data research agent CLI",
  "type": "module",
  "bin": {
    "scout": "./dist/index.js"
  },
  "scripts": {
    "copy-python": "node scripts/copy-python.js",
    "build": "npm run copy-python && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "pack": "npm run build && npm pack"
  },
  "files": [
    "dist/",
    "python/",
    "scripts/"
  ],
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.39",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "eventsource-parser": "^3.0.0",
    "fzf": "^0.5.2",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "string-width": "^8.2.0",
    "unified": "^11.0.5",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
