{
  "name": "scout-cli",
  "version": "0.1.0",
  "description": "Scout — an AI-powered data research agent CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scout-cli": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./App": "./dist/App.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "scout-core": "0.1.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "fzf": "^0.5.2",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "string-width": "^8.2.0",
    "unified": "^11.0.5",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
