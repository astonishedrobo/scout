{
  "name": "scout-core",
  "version": "0.1.0",
  "description": "Scout — shared core: types, API client, config, server lifecycle",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "scripts": {
    "copy-python": "node scripts/copy-python.js",
    "build": "npm run copy-python && tsc",
    "dev": "tsc --watch"
  },
  "files": [
    "dist/",
    "python/",
    "scripts/"
  ],
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.64",
    "chalk": "^5.3.0",
    "eventsource-parser": "^3.0.0",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
